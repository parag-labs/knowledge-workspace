# Knowledge Workspace runs on a deterministic hashing embedder and a mock query planner by
# default, so no API keys are needed to develop, test, build, or run the demo.

# Which planner to use: "mock" (default, deterministic) or a real provider you wire in.
KNOWLEDGE_PLANNER=mock

# Optional Postgres for the self-host persistence layer (the Store in src/db). The demo app
# runs client-side and does not require it. CI's integration job sets this to a throwaway DB.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/knowledge_workspace

# Only needed if you wire a real embedding/LLM provider. Never commit a real key.
# OPENAI_API_KEY=sk-...
